{
  "name": "sawitpro-web-automation",
  "version": "1.0.0",
  "description": "Sample Cypress web automation project for https://www.sawitpro.id/ - covers main menu navigation, homepage, and key product/info pages.",
  "private": true,
  "scripts": {
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "test": "cypress run",
    "test:headed": "cypress run --headed",
    "test:chrome": "cypress run --browser chrome",
    "test:menu": "cypress run --spec cypress/e2e/navigation/main-menu.cy.js",
    "test:homepage": "cypress run --spec cypress/e2e/homepage/homepage.cy.js",
    "allure:clean": "rimraf allure-results allure-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "allure:report": "npm run allure:generate && npm run allure:open",
    "test:report": "npm run allure:clean && npm run cypress:run; npm run allure:report"
  },
  "devDependencies": {
    "allure-commandline": "^2.30.0",
    "allure-cypress": "^3.0.0",
    "cypress": "^13.15.0",
    "cypress-real-events": "^1.13.0",
    "rimraf": "^5.0.5"
  },
  "keywords": [
    "cypress",
    "e2e",
    "automation",
    "sawitpro"
  ]
}
